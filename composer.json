{
    "name": "infrangible/m2-page-elements",
    "description": "Switches off or replaces standard page elements such as header, navigation, footer, breadcrumbs, page titles, compare links, related products and stock info from the configuration.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Content",
        "Catalog",
        "remove breadcrumbs and page elements",
        "hide header or footer elements",
        "disable compare links"
    ],
    "homepage": "https://www.infrangible.dev/modules/page-elements",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-core": "~5.0.6",
        "infrangible/m2-foundation": "~3.0.2",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0",
        "magento/module-catalog-widget": "~100.4.0",
        "magento/module-checkout": "~100.4.0",
        "magento/module-cms": "~104.0.0",
        "magento/module-store": "~101.1.0",
        "magento/module-theme": "~101.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\PageElements\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}
